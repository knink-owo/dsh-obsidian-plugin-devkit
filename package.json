{
  "name": "@knink-owo/dsh-obsidian-plugin-devkit",
  "version": "0.1.0",
  "description": "Obsidian community plugin development capabilities for DeepSeek Harness agents: scaffolding, building, validation and versioning.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "doc",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "test": "node --test --test-isolation=none test/naming.test.mjs test/templates.test.mjs test/scaffold.test.mjs test/version.test.mjs test/plugin.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  }
}
